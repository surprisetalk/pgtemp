{
  "lock": { "frozen": true },
  "name": "@surprisetalk/pgtemp",
  "version": "0.2.7",
  "license": "MIT",
  "exports": "./mod.ts",
  "imports": {
    "@electric-sql/pglite": "npm:@electric-sql/pglite@0.5.16",
    "pg-gateway": "npm:pg-gateway@0.3.0-beta.4",
    "postgres": "npm:postgres@^3.4.5",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "tasks": {
    "test": "deno test --allow-net --allow-read --allow-env --allow-write=/tmp/pgtemp",
    "status": "deno run --allow-net --allow-read --allow-env status.ts",
    "hooks": "git config core.hooksPath .githooks"
  },
  "publish": {
    "exclude": [
      "todo.md",
      "mod.test.ts",
      "smoke.ts",
      "status.ts",
      ".github",
      ".githooks"
    ]
  },
  "fmt": {
    "lineWidth": 120,
    "useBraces": "preferNone",
    "singleBodyPosition": "maintain"
  }
}
