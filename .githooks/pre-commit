#!/bin/sh
# Same checks as .github/workflows/ci.yml, in the same order: a commit that
# passes here passes CI. Skip with `git commit --no-verify`.
set -e
# REVIEW: deno audit needs the network, and a new advisory blocks unrelated commits. Alternative: a status condition. It allows offline commits but lets a vulnerable dependency ship.
timeout 30 deno audit
deno fmt --check || { printf '\n  fix with: deno fmt\n\n'; exit 1; }
deno lint
deno check mod.ts mod.test.ts
deno task test
